# The address of the backend. Vite only exposes variables starting with VITE_.
#
# IMPORTANT: this is read when the site is BUILT, not when somebody opens it.
# Change it and you have to build again, or the old address stays baked in.
#
# On a laptop you do not need this file at all. The default is the line below.
VITE_API_BASE=http://127.0.0.1:8000

# On Vercel, do not use this file. Put the same name and value in
# Settings -> Environment Variables, then redeploy so it gets built in:
#   VITE_API_BASE = https://your-api-name.onrender.com
