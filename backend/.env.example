# Copy this file to `.env` and edit it. Everything here is optional — the API
# runs with no .env at all, using local SQLite storage.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The app ALWAYS reads and writes locally: SQLite for users and work logs,
# data/projects.json for project data. There is no live Supabase code path.
#
# Setting this to "supabase" does not change where the app stores anything. It
# only marks that a mirror is configured, which the startup log reports and
# scripts/sync_supabase.py uses to push a copy upstream.
DATA_BACKEND=local

# Only needed if you want to publish a copy to Supabase with
# scripts/sync_supabase.py.
# NEVER commit a real key. Rotate immediately if one is ever shared.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-key

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Signs session tokens. CHANGE THIS before deploying anywhere public —
# anyone who knows it can mint a valid token for any account.
SECRET_KEY=sns-dev-key-change-in-production

# Session lifetime in seconds (default 12 hours).
TOKEN_TTL_SECONDS=43200

# Shared password for the seeded demo accounts.
DEMO_PASSWORD=nigrani

# ---------------------------------------------------------------------------
# Which websites are allowed to read replies from this API
# ---------------------------------------------------------------------------
# A browser will not let a page on one address read a reply from a different
# address unless this server says that address is allowed. Get this wrong and
# the frontend shows "cannot reach the data server" even though the API is up
# and answering perfectly well in a browser tab.
#
# Exact addresses, comma separated. No trailing slash. "*" means any website.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# A pattern, for hosts that hand out a new address on every deploy. The default
# below already covers Vercel, Netlify, Render and GitHub Pages, so a normal
# deploy works without touching anything. Set it to an empty value to switch
# that off and rely only on the exact list above.
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.(vercel\.app|netlify\.app|onrender\.com|github\.io)

# ---------------------------------------------------------------------------
# Gemini photo descriptions (optional)
# ---------------------------------------------------------------------------
# Without a key the website says the feature is not connected and produces
# nothing. Keep the key on the server; never put it in the frontend.
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_DAILY_LIMIT=20
