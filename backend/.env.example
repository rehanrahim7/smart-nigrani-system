# Copy this file to `.env` and edit it. Everything here is optional — the API
# runs with no .env at all, using local SQLite storage.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The app ALWAYS reads and writes locally: SQLite for users and work logs,
# data/projects.json for project data. There is no live Supabase code path.
#
# Setting this to "supabase" does not change where the app stores anything. It
# only marks that a mirror is configured, which the startup log reports and
# scripts/sync_supabase.py uses to push a copy upstream.
DATA_BACKEND=local

# Only needed if you want to publish a copy to Supabase with
# scripts/sync_supabase.py.
# NEVER commit a real key. Rotate immediately if one is ever shared.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-key

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Signs session tokens. CHANGE THIS before deploying anywhere public —
# anyone who knows it can mint a valid token for any account.
SECRET_KEY=sns-dev-key-change-in-production

# Session lifetime in seconds (default 12 hours).
TOKEN_TTL_SECONDS=43200

# Shared password for the seeded demo accounts.
DEMO_PASSWORD=nigrani

# ---------------------------------------------------------------------------
# Frontend origins allowed to call this API (comma separated)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
